# HTTP Tunnel Configuration
# Copy to .env and edit

# Required - shared secret between server and client
ENCRYPTION_KEY=your-secret-key-here

# Server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# Client
SOCKS_LISTEN_HOST=127.0.0.1
SOCKS_LISTEN_PORT=1080
SERVER_URL=http://your-server:8080/tunnel
OUTBOUND_PROXY=

# DNS (server=no leaks, local=use system DNS)
DNS_MODE=server

# Routing: tunnel, proxy, direct
ROUTE_TLS=tunnel
ROUTE_HTTP=tunnel
ROUTE_OTHER=tunnel

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO